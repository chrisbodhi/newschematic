{{- /*
  Builds feed.xml (§7): one <item> per publish event across every blyg
  item, newest first, windowed to 50. isPlainText = true on the
  `blygfeed` output format (config.toml) is load-bearing here -- without
  it, Hugo runs this literal template text through html/template's HTML
  escaper, which corrupts the leading <?xml ...?> prolog even though
  this template has no actions before it (see docs/blyg/conformance.md).
  content_html is inserted as an escaped XML text node rather than
  wrapped in CDATA, so behavior doesn't change under --minify and a
  literal "]]>" inside a post's content can never break the feed.
*/ -}}
{{- $base := site.BaseURL -}}
{{- $ledger := site.Data.blyg.ledger -}}
{{- $manifestURL := printf "%sblyg/blyg.json" $base -}}

{{- $events := slice -}}
{{- range .Pages -}}
  {{- $page := . -}}
  {{- $id := $page.Params.blyg_id -}}
  {{- with $id -}}
    {{- $entry := index $ledger . -}}
    {{- if $entry -}}
      {{- $doc := partial "blyg/item.html" (dict "page" $page "ledger" $entry "base" $base) -}}
      {{- if $entry.withdrawn -}}
        {{- /* Exactly one entry for a withdrawn item; earlier events dropped (§7). */ -}}
        {{- $last := index $entry.changelog (sub (len $entry.changelog) 1) -}}
        {{- $events = $events | append (dict
            "id" $id "version" $last.version "at" $last.at
            "kind" "withdrawn" "title" "withdrawn" "description" ""
            "created" $doc.created
        ) -}}
      {{- else -}}
        {{- range $entry.changelog -}}
          {{- $events = $events | append (dict
              "id" $id "version" .version "at" .at
              "kind" "thread" "title" $page.Title "description" $doc.content_html
              "created" $doc.created
          ) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $events = sort $events "at" "desc" -}}
{{- $events = first 50 $events -}}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:blyg="https://blygger.org/ns/0.1">
  <channel>
    <title>{{ site.Title | htmlEscape }}</title>
    <link>{{ $base }}blyg/</link>
    <description>{{ site.Params.description | htmlEscape }}</description>
    <lastBuildDate>{{ now.UTC.Format "Mon, 02 Jan 2006 15:04:05 GMT" }}</lastBuildDate>
    <blyg:level>1</blyg:level>
    <blyg:manifest>{{ $manifestURL }}</blyg:manifest>
    {{- range $events }}
    <item>
      <guid isPermaLink="false">blyg:{{ .id }}:v{{ .version }}</guid>
      <title>{{ .title | htmlEscape }}</title>
      <description>{{ .description | htmlEscape }}</description>
      <pubDate>{{ (time.AsTime .at).UTC.Format "Mon, 02 Jan 2006 15:04:05 GMT" }}</pubDate>
      <blyg:id>{{ .id }}</blyg:id>
      <blyg:kind>{{ .kind }}</blyg:kind>
      <blyg:version>{{ .version }}</blyg:version>
      <blyg:created>{{ .created }}</blyg:created>
      <blyg:item>{{ $base }}blyg/items/{{ .id }}.json</blyg:item>
    </item>
    {{- end }}
  </channel>
</rss>
